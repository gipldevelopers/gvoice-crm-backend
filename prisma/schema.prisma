generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id              String          @id @default(uuid())
  name            String
  email           String?
  address         String?
  logo            String?
  gstNo           String?
  status          String          @default("active")
  officeLatitude  Float?
  officeLongitude Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tasks           Task[]
  customers       Customer[]
  deals           Deal[]
  departments     Department[]
  eodEntries      EodEntry[]
  leads           Lead[]
  projects        Project[]
  roles           Role[]
  salesEodEntries SalesEodEntry[]
  techTaskBatches TechTaskBatch[]
  techTaskItems   TechTaskItem[]
  users           User[]

  @@map("companies")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("departments")
}

model Role {
  id         String   @id @default(uuid())
  name       String
  baseRole   String   @default("employee")
  department String?
  companyId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("roles")
}

model User {
  id                                     String          @id @default(uuid())
  username                               String          @unique
  fullName                               String
  email                                  String          @unique
  phone                                  String?
  password                               String
  department                             String?
  teamName                               String?
  role                                   String          @default("employee")
  status                                 String          @default("active")
  reportsToId                            String?
  token                                  String?
  companyId                              String
  createdAt                              DateTime        @default(now())
  updatedAt                              DateTime        @updatedAt
  reportsToL2Id                          String?
  reportsToL3Id                          String?
  dealApprovals                          DealApproval[]
  dealDocuments                          DealDocument[]
  deals                                  Deal[]          @relation("AssignedDeals")
  eodEntries                             EodEntry[]
  files                                  File[]
  leadApprovals                          LeadApproval[]
  leadAuditLogs                          LeadAuditLog[]
  leadDocuments                          LeadDocument[]
  leads                                  Lead[]          @relation("AssignedLeads")
  projectTasks                           ProjectTask[]   @relation("ProjectTaskAssignedTo")
  assignedProjects                       Project[]       @relation("AssignedPM")
  salesEodEntries                        SalesEodEntry[]
  createdTechTaskBatches                 TechTaskBatch[] @relation("TechTaskBatchCreatedBy")
  assignedTechTaskItems                  TechTaskItem[]  @relation("TechTaskItemAssignedTo")
  company                                Company         @relation(fields: [companyId], references: [id])
  reportsTo                              User?           @relation("UserHierarchy", fields: [reportsToId], references: [id])
  directReports                          User[]          @relation("UserHierarchy")
  users_users_reportsToL2IdTousers       User?           @relation("users_reportsToL2IdTousers", fields: [reportsToL2Id], references: [id])
  other_users_users_reportsToL2IdTousers User[]          @relation("users_reportsToL2IdTousers")
  users_users_reportsToL3IdTousers       User?           @relation("users_reportsToL3IdTousers", fields: [reportsToL3Id], references: [id])
  other_users_users_reportsToL3IdTousers User[]          @relation("users_reportsToL3IdTousers")
  activityLogs                           ActivityLog[]

  @@index([companyId])
  @@index([companyId, department])
  @@index([companyId, role])
  @@index([reportsToId])
  @@map("users")
}

model File {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  path         String
  size         Int
  mimetype     String
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("files")
}

model Lead {
  id               String         @id @default(uuid())
  name             String
  phone            String?
  countryCode      String?
  email            String?
  source           String
  service          String?
  value            Float?
  currency         String?
  status           String         @default("New")
  notes            String?
  salespersonId    String?
  companyId        String
  complianceStatus String         @default("NA")
  department       String         @default("sales")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  customer         Customer?
  approvals        LeadApproval[]
  auditLogs        LeadAuditLog[]
  documents        LeadDocument[]
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesperson      User?          @relation("AssignedLeads", fields: [salespersonId], references: [id])

  @@map("leads")
}

model LeadApproval {
  id         String   @id @default(uuid())
  leadId     String
  level      String
  status     String   @default("PENDING")
  approverId String?
  comments   String?
  deadline   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  approver   User?    @relation(fields: [approverId], references: [id])
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, level])
  @@map("lead_approvals")
}

model LeadAuditLog {
  id          String   @id @default(cuid())
  leadId      String
  companyId   String
  actorUserId String?
  action      String
  changes     Json?
  message     String?
  createdAt   DateTime @default(now())
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([companyId, createdAt])
  @@map("lead_audit_logs")
}

model LeadDocument {
  id           String   @id @default(uuid())
  leadId       String
  documentType String
  version      Int
  filename     String
  originalName String
  path         String
  mimetype     String
  size         Int
  uploadedBy   String?
  createdAt    DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploader     User?    @relation(fields: [uploadedBy], references: [id])

  @@index([leadId, documentType])
  @@map("lead_documents")
}

model Customer {
  id             String   @id @default(uuid())
  type           String   @default("Company")
  name           String
  contactPerson  String?
  email          String
  phone          String
  alternatePhone String?
  gst            String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  notes          String?
  status         String   @default("Active")
  companyId      String
  leadId         String?  @unique
  department     String   @default("sales")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead           Lead?    @relation(fields: [leadId], references: [id])
  deals          Deal[]

  @@map("customers")
}

model Deal {
  id               String         @id @default(uuid())
  title            String
  value            Float
  stage            String         @default("New Deal")
  closingDate      DateTime?
  probability      Int            @default(10)
  notes            String?
  salespersonId    String?
  customerId       String?
  companyId        String
  complianceStatus String         @default("PENDING")
  projectGenerated Boolean        @default(false)
  department       String         @default("sales")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  approvals        DealApproval[]
  documents        DealDocument[]
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer?      @relation(fields: [customerId], references: [id])
  salesperson      User?          @relation("AssignedDeals", fields: [salespersonId], references: [id])
  project          Project?

  @@map("deals")
}

model Task {
  id         String   @id @default(cuid())
  title      String
  type       String
  linkedType String
  linkedId   String?
  linkedTo   String?
  assignedTo String
  dueDate    DateTime
  dueTime    String
  status     String   @default("Pending")
  priority   String   @default("Medium")
  notes      String?
  department String   @default("sales")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

model DealDocument {
  id           String   @id @default(uuid())
  dealId       String
  documentType String
  filename     String
  originalName String
  path         String
  mimetype     String
  size         Int
  uploadedBy   String?
  createdAt    DateTime @default(now())
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  uploader     User?    @relation(fields: [uploadedBy], references: [id])

  @@index([dealId, documentType])
  @@map("deal_documents")
}

model DealApproval {
  id         String   @id @default(uuid())
  dealId     String
  level      String
  status     String   @default("PENDING")
  approverId String?
  comments   String?
  deadline   DateTime
  escalated  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  approver   User?    @relation(fields: [approverId], references: [id])
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, level])
  @@map("deal_approvals")
}

model Project {
  id                  String             @id @default(uuid())
  projectId           String             @unique
  name                String
  dealId              String             @unique
  companyId           String
  status              String             @default("Active")
  department          String             @default("sales")
  techLeadAcknowledge Boolean            @default(false)
  acknowledgedAt      DateTime?
  escalatedToHead     Boolean            @default(false)
  pmAssignedId        String?
  planningStartTime   DateTime?
  planLocked          Boolean            @default(false)
  planApproved        Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  milestones          ProjectMilestone[]
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal                Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  pm                  User?              @relation("AssignedPM", fields: [pmAssignedId], references: [id])
  techTaskBatches     TechTaskBatch[]

  @@map("projects")
}

model ProjectMilestone {
  id          String        @id @default(uuid())
  title       String
  description String?
  deadline    DateTime?
  status      String        @default("Pending")
  projectId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       ProjectTask[]

  @@map("project_milestones")
}

model ProjectTask {
  id               String           @id @default(uuid())
  title            String
  description      String?
  deliverable      String?
  deadline         DateTime?
  estimatedHours   Float?
  status           String           @default("Pending")
  priority         String           @default("Medium")
  assignedToId     String?
  assignedAt       DateTime?
  acceptanceStatus String?
  acceptedAt       DateTime?
  acceptanceDueAt  DateTime?
  escalatedAt      DateTime?
  milestoneId      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assignedTo       User?            @relation("ProjectTaskAssignedTo", fields: [assignedToId], references: [id])
  milestone        ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@map("project_tasks")
}

model EodEntry {
  id                String   @id @default(uuid())
  entryDate         DateTime
  tasksWorked       Json?
  hoursLogged       Float?
  completionPercent Int?
  blockers          String?
  productivityScore Int?
  productivityNotes String?
  userId            String
  companyId         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
  @@index([companyId, entryDate])
  @@map("eod_entries")
}

model TechTaskBatch {
  id          String         @id @default(uuid())
  headTitle   String
  projectId   String?
  companyId   String
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("TechTaskBatchCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  project     Project?       @relation(fields: [projectId], references: [id])
  tasks       TechTaskItem[]

  @@index([companyId, createdAt])
  @@map("tech_task_batches")
}

model TechTaskItem {
  id             String        @id @default(uuid())
  batchId        String
  title          String
  assignedToId   String?
  estimatedHours Float?
  notes          String?
  status         String        @default("Assigned")
  completionNote String?
  completedAt    DateTime?
  blockerNote    String?
  blockedAt      DateTime?
  failureNote    String?
  failedAt       DateTime?
  companyId      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  assignedTo     User?         @relation("TechTaskItemAssignedTo", fields: [assignedToId], references: [id])
  batch          TechTaskBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, assignedToId])
  @@map("tech_task_items")
}

model SalesEodEntry {
  id              String   @id @default(uuid())
  entryDate       DateTime
  leadsWorked     Json?
  trackingItems   Json?
  callsMade       Int?
  progressUpdates String?
  blockers        String?
  userId          String
  companyId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
  @@index([companyId, entryDate])
  @@map("sales_eod_entries")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  action    String   // "LOGIN", "LOGOUT", etc.
  device    String?  // e.g. "Windows / Chrome", "iPhone / Safari"
  ipAddress String?  // Client IP address
  location  String?  // Reverse geocoded user location (e.g. Surat, India)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@map("activity_logs")
}
